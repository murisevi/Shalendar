# --- Server ---
PORT=3001
NODE_ENV=development

# --- PostgreSQL ---
# Local Docker Compose default:
DATABASE_URL=postgres://shalendar:shalendar_dev@localhost:5432/shalendar
# Set to "true" for managed Postgres (Northflank external URL, Neon, Railway, etc.)
# Set to "auto" to enable SSL automatically when NODE_ENV=production and host != localhost
DATABASE_SSL=auto
# Keep pool small + short idle timeout to work smoothly with serverless Postgres (e.g. Neon)
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=15000

# --- Adaptive Persistence (100% accountless) ---
# Options: ephemeral_after_event | fixed_ttl | sliding_inactivity | persistent
DEFAULT_RETENTION_POLICY=ephemeral_after_event
# Default TTL in days when no confirmed date exists (or for fixed_ttl / sliding_inactivity)
DEFAULT_RETENTION_DAYS=30
# Days kept after confirmed_date when policy is ephemeral_after_event
POST_EVENT_GRACE_DAYS=14
# Background purge cadence in hours (set 0 to disable in-process interval and rely on external Cron Job)
PURGE_INTERVAL_HOURS=12
# Optional bearer secret to protect POST /api/internal/purge for external PaaS Cron Jobs (e.g. Northflank Cron)
PURGE_CRON_SECRET=

# --- Demo & Safety ---
ALLOW_PUBLIC_DEMO=true
