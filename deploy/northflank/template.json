{
  "apiVersion": "v1.2",
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "shalendar",
            "region": "europe-west",
            "description": "Shalendar — calendario colaborativo sin cuentas con PostgreSQL y persistencia adaptativa",
            "color": "#0d9488"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "parallel",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Addon",
                "ref": "shalendar_postgres",
                "spec": {
                  "name": "shalendar-postgres",
                  "type": "postgresql",
                  "version": "16-latest",
                  "billing": {
                    "deploymentPlan": "nf-compute-20"
                  }
                }
              }
            ]
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "SecretGroup",
                "ref": "shalendar_secrets",
                "spec": {
                  "name": "shalendar-secrets",
                  "type": "secret",
                  "secretType": "environment",
                  "secrets": {
                    "variables": {}
                  },
                  "addonDependencies": [
                    {
                      "addonId": "${refs.shalendar_postgres.id}",
                      "keys": [
                        {
                          "keyName": "POSTGRES_URI",
                          "aliases": ["DATABASE_URL", "POSTGRES_URI"]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "Service",
                "ref": "shalendar_web",
                "spec": {
                  "name": "shalendar-web",
                  "type": "combined",
                  "billing": {
                    "deploymentPlan": "nf-compute-20"
                  },
                  "build": {
                    "type": "git",
                    "repository": {
                      "repository": "https://github.com/murisevi/Shalendar.git",
                      "branch": "master",
                      "authenticationMethod": "public"
                    },
                    "dockerfile": {
                      "path": "Dockerfile"
                    }
                  },
                  "runtime": {
                    "ports": [
                      {
                        "name": "http",
                        "port": 3001,
                        "public": true
                      }
                    ],
                    "environmentVariables": [
                      {
                        "name": "NODE_ENV",
                        "type": "plain",
                        "value": "production"
                      },
                      {
                        "name": "PORT",
                        "type": "plain",
                        "value": "3001"
                      },
                      {
                        "name": "DATABASE_SSL",
                        "type": "plain",
                        "value": "auto"
                      },
                      {
                        "name": "DEFAULT_RETENTION_POLICY",
                        "type": "plain",
                        "value": "ephemeral_after_event"
                      },
                      {
                        "name": "DEFAULT_RETENTION_DAYS",
                        "type": "plain",
                        "value": "30"
                      },
                      {
                        "name": "POST_EVENT_GRACE_DAYS",
                        "type": "plain",
                        "value": "14"
                      },
                      {
                        "name": "PURGE_INTERVAL_HOURS",
                        "type": "plain",
                        "value": "12"
                      },
                      {
                        "name": "ALLOW_PUBLIC_DEMO",
                        "type": "plain",
                        "value": "true"
                      },
                      {
                        "name": "REQUIRE_POSTGRES",
                        "type": "plain",
                        "value": "true"
                      }
                    ],
                    "healthChecks": {
                      "readiness": {
                        "type": "http",
                        "http": {
                          "path": "/api/health",
                          "port": 3001,
                          "scheme": "HTTP"
                        },
                        "initialDelaySeconds": 10,
                        "periodSeconds": 15,
                        "timeoutSeconds": 3,
                        "failureThreshold": 3
                      },
                      "liveness": {
                        "type": "http",
                        "http": {
                          "path": "/api/health",
                          "port": 3001,
                          "scheme": "HTTP"
                        },
                        "initialDelaySeconds": 25,
                        "periodSeconds": 30,
                        "timeoutSeconds": 3,
                        "failureThreshold": 3
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
